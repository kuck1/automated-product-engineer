{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "surface": {
      "default": { "$type": "color", "$value": "#ffffff" },
      "subtle": { "$type": "color", "$value": "#f7f7f8" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#171719" },
      "secondary": { "$type": "color", "$value": "#66666b" }
    },
    "action": {
      "primary": { "$type": "color", "$value": "#315efb" },
      "primaryHover": { "$type": "color", "$value": "#244bd7" }
    },
    "border": {
      "default": { "$type": "color", "$value": "#dfdfe3" },
      "focus": { "$type": "color", "$value": "#315efb" }
    }
  },
  "space": {
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "6": { "$type": "dimension", "$value": "24px" }
  },
  "radius": {
    "control": { "$type": "dimension", "$value": "10px" },
    "surface": { "$type": "dimension", "$value": "16px" }
  },
  "motion": {
    "durationFast": { "$type": "duration", "$value": "120ms" },
    "durationDefault": { "$type": "duration", "$value": "180ms" }
  }
}
