{
  "expo": {
    "name": "Native Product",
    "slug": "native-product",
    "scheme": "native-product",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": { "policy": "appVersion" },
    "plugins": ["expo-router", "expo-secure-store"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.nativeproduct"
    },
    "android": {
      "package": "com.example.nativeproduct"
    },
    "extra": {
      "router": { "origin": false }
    }
  }
}
