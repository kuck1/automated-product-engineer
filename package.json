{
  "name": "automated-product-engineer-nextjs",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts && node --test packages/automated-product-engineer/test/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "install:toolkit": "node packages/automated-product-engineer/bin/automated-product-engineer.mjs install",
    "install:skills": "node packages/automated-product-engineer/bin/automated-product-engineer.mjs install --only skills",
    "validate:content": "python3 scripts/validate.py",
    "verify": "pnpm validate:content && pnpm test && pnpm typecheck && pnpm lint && pnpm build"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.115.0",
    "@tanstack/react-query": "5.102.8",
    "lucide-react": "1.41.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0-alpha-2026-08-31",
    "@types/node": "20.19.25",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.18.3"
}
